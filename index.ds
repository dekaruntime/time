// Host-granted time. now() is Date.now; only sleep_ms is a host op.

// Date.now is total: expose the timestamp directly instead of hiding errors as zero.
summon { total now_ms() number } from "./shim.mjs"

export fn now() number {
  return now_ms()
}

export fn sleep_ms(ms: number) {
  return bridge time.sleep_ms(ms)
}
